{
  "name": "government-support-matching-platform",
  "version": "1.4.0",
  "description": "정부지원사업 매칭 에이전트 플랫폼 - 92% 매칭 정확도로 기업 특성을 분석하여 실제 지원 가능한 정부지원사업을 정확하게 매칭해주는 AI 서비스",
  "type": "spa-application",
  "framework": "react-typescript",
  "buildDate": "2024-12-19",
  
  "features": {
    "core": [
      "AI 매칭 엔진 (92% 정확도)",
      "실시간 정부지원사업 매칭",
      "기업 특성 종합 분석",
      "구체적인 선정 가능성 제공"
    ],
    "subscription": [
      "3단계 구독 플랜 시스템",
      "베이직/프리미엄/엔터프라이즈",
      "구독 상태 관리",
      "플랜 변경 기능"
    ],
    "promotion": [
      "프로모션 코드 생성/관리",
      "할인 혜택 적용",
      "사용 내역 추적",
      "관리자 프로모션 관리"
    ],
    "admin": [
      "종합 관리자 대시보드",
