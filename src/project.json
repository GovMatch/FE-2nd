      "매칭 현황 분석",
      "세일즈 퍼널 관리"
    ]
  },
  
  "pages": {
    "user": [
      "MainPage - 메인 랜딩페이지",
      "LoginPage - 로그인",
      "SignupPage - 회원가입", 
      "MyPage - 마이페이지",
      "MatchingPage - 매칭 결과",
      "SuccessPage - 성공 페이지",
      "GuidePage - 가이드"
    ],
    "admin": [
      "AdminPage - 관리자 대시보드"
    ]
  },
  
  "components": {
    "total": 42,
    "ui": 35,
    "business": 7,
    "custom": [
      "PromoCodeInput",
      "PromoCodeManagement", 
      "SubscriptionPlans",
      "SubscriptionModal",
      "CustomerFunnelManagement",
      "VoucherProviderManagement",
      "MatchingDetailModal"
    ]
